{
  "name": "librarian",
  "version": "0.2.0",
  "description": "Experiments with a librarian for vrlbry's candle-lit 3D library of Kiwix ZIM files, one who can only find things: ask, and be taken to the book. In VR (Meta Quest), on a desktop or a phone. A fork of vrlbry.",
  "keywords": ["librarian", "search", "webxr", "virtual-reality", "threejs", "meta-quest", "kiwix", "zim", "openzim", "project-gutenberg", "wikipedia", "wikisource", "ebook-reader", "digital-library", "offline-first"],
  "homepage": "https://ariamokr.github.io/librarian/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AriaMoKr/librarian.git"
  },
  "bugs": {
    "url": "https://github.com/AriaMoKr/librarian/issues"
  },
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.15.0"
  },
  "bin": {
    "vrlbry": "server/index.js"
  },
  "scripts": {
    "start": "node server/index.js",
    "start:https": "node server/index.js --https",
    "test": "node --test \"test/*.test.js\"",
    "types": "tsc -p tsconfig.json",
    "perf:quest": "node tools/quest-perf.mjs",
    "build:pages": "node tools/build-pages.mjs"
  },
  "dependencies": {
    "common": "github:AriaMoKr/common#v0.8.3",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "htmlparser2": "^12.0.0",
    "layersharedsession": "github:AriaMoKr/layersharedsession#v0.3.0",
    "selfsigned": "^5.5.0",
    "three": "^0.186.1",
    "trystero": "0.26.0"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "fake-indexeddb": "^6.2.5",
    "iwer": "^2.5.0",
    "typescript": "5.9.3"
  }
}
